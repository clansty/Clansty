#!/usr/bin/env python3
from __future__ import annotations

import argparse
from pathlib import Path
from urllib.parse import quote


def convert_line(line: str) -> str | None:
    value = line.strip()
    if not value or value.startswith("#"):
        return None

    parts = value.split(":")
    if len(parts) != 4:
        raise ValueError(f"unsupported proxy format: {value!r}")

    server, port, user, password = parts
    user = quote(user, safe="")
    password = quote(password, safe="")
    return f"http://{user}:{password}@{server}:{port}"


def convert_file(input_path: Path, output_path: Path, wrap_brackets: bool) -> int:
    converted: list[str] = []
    for line_number, line in enumerate(input_path.read_text().splitlines(), start=1):
        try:
            result = convert_line(line)
        except ValueError as exc:
            raise ValueError(f"{input_path}:{line_number}: {exc}") from exc

        if result:
            converted.append(f"[{result}]" if wrap_brackets else result)

    output_path.write_text("\n".join(converted) + ("\n" if converted else ""))
    return len(converted)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Convert Webshare server:port:user:pass proxies to http://user:pass@server:port."
    )
    parser.add_argument("input", type=Path, help="Input proxy text file")
    parser.add_argument(
        "-o",
        "--output",
        type=Path,
        help="Output file. Defaults to '<input>.converted.txt'.",
    )
    parser.add_argument(
        "--brackets",
        action="store_true",
        help="Write each proxy as [http://user:pass@server:port].",
    )
    args = parser.parse_args()

    input_path = args.input.expanduser()
    output_path = args.output.expanduser() if args.output else input_path.with_suffix(input_path.suffix + ".converted.txt")

    count = convert_file(input_path, output_path, args.brackets)
    print(f"Converted {count} proxies -> {output_path}")


if __name__ == "__main__":
    main()
