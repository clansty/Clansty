// ────────────── desktop overrides ──────────────

output "DP-1" {
    mode "5120x2160@120.000"
    scale 1.35
    position x=900 y=0
}

output "DP-3" {
    mode "2560x1600@160.000"
    scale 1.6
    transform "90"
    position x=0 y=0
}

workspace "QQ" {
    open-on-output "DP-3"
}

workspace "TG" {
    open-on-output "DP-3"
}

window-rule {
    exclude app-id=r"^$" title=r"^$"
    open-on-output "DP-1" // 新窗口默认开在主屏，手动拖到副屏不受影响
    open-focused true // 强制聚焦新窗口（否则焦点会留在副屏）
}

window-rule {
    match title=r"Icalingua\+\+ Main"
    open-on-output "DP-3"
    open-maximized-to-edges true
    open-on-workspace "QQ"
}

window-rule {
    match title="0wGram"
    open-on-output "DP-3"
    open-maximized-to-edges true
    open-on-workspace "TG"
}
