    layout {
        gaps 12 // Gap between windows
        center-focused-column "never" // 切换焦点不滚动视图（点击窗口不会跳动）
        always-center-single-column // 但工作区只有一列时始终居中，新工作区开窗不会贴左

        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        default-column-width { proportion 0.9; }

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
            proportion 0.75
        }

        struts {}
    }
