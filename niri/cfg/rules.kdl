    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
        default-column-width {} // Use every window's own preferred size
    }

    window-rule {
        match title="Sinmai"
        open-floating false
    }

    window-rule {
        match title=r"Icalingua\+\+ ImageViewer"
        open-floating true
    }

    window-rule {
        match title=r"Icalingua\+\+ Main"
        open-floating false
    }

    window-rule {
        match title="0wGram"
        open-floating false
    }

    window-rule {
        match app-id=r"^$" title=r"^$"
        open-floating true
        open-focused false  
        geometry-corner-radius 0
        clip-to-geometry false
    }

    window-rule {
        match title="Hold on..."
        open-floating true
    }

    window-rule {
        match title="Starting Unity..."
        open-floating true
    }

    window-rule {
        match title="Open Orpheus Lyrics"
        open-floating true
        open-focused false   // 打开时不抢焦点
        focus-ring { off; }   // 去掉聚焦时 niri 画的高亮环
    }

    window-rule {
        match app-id="unity-ime-dialog.py"
        open-floating true
    }

    window-rule {
        match app-id="labwc"
        default-column-width { fixed 2000; }
    }

    window-rule {
        match app-id="fusion360.exe"
        default-column-width { fixed 2000; }
    }

    window-rule {
        match app-id="looking-glass-client"
        default-column-width { fixed 2915; }
    }

    window-rule {
        match app-id="msedge-hass.c5y.moe__-Profile_1"
        default-column-width { fixed 1900; }
    }

    window-rule {
        match app-id="org.gnome.Nautilus"
        default-column-width { fixed 1200; }
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

